# Copy to .env for local dev. Production values are Fly secrets (SPEC 9.3).
APP_PASSWORD_HASH=   # argon2id hash of the shared password
SESSION_SECRET=      # cookie signing key; rotating it logs everyone out
DATABASE_PATH=local.db
# Claude (SPEC 5.1, 5.9)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=medium
DAILY_CALL_CAP=50
# R2 (photos + Litestream replication). Token: dashboard > R2 > Manage API Tokens,
# Object Read & Write, scoped to the "wecooked" bucket only. Names per SPEC 9.3;
# the LITESTREAM_* pair may reuse the R2_* values.
R2_ACCOUNT_ID=
R2_BUCKET=wecooked
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
