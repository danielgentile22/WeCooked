# Copy to .env for local dev. Production values are Fly secrets (SPEC 9.3).
APP_PASSWORD_HASH=   # argon2id hash of the shared password
SESSION_SECRET=      # cookie signing key; rotating it logs everyone out
DATABASE_PATH=local.db
# Claude (SPEC 5.1, 5.9)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=medium
DAILY_CALL_CAP=50
# Found covers (ADR-043). Brave Search API, images endpoint: about $5 per 1000
# queries, covered by the monthly free credit. Unset means no image search.
BRAVE_SEARCH_API_KEY=
# Optional: the model that picks among search hits (default claude-sonnet-5-5).
COVER_MODEL=
# R2 (photos + Litestream replication). Token: dashboard > R2 > Manage API Tokens,
# Object Read & Write, scoped to the "wecooked" bucket only. Names per SPEC 9.3;
# the LITESTREAM_* pair may reuse the R2_* values.
R2_ACCOUNT_ID=
R2_BUCKET=wecooked
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
# Capture-ready push (issue #42). Unset means no pushes.
APNS_KEY=       # the .p8 push key: PEM, PEM with \n for newlines, or base64 of the PEM
APNS_KEY_ID=    # the push key's 10-character Key ID from the developer website
APNS_TEAM_ID=   # the Apple Developer Team ID that owns the key
# Dev only: IMAGE_STORE=local writes photos to IMAGE_STORE_DIR (default .dev-images) instead of R2.
# IMAGE_STORE=local
# IMAGE_STORE_DIR=.dev-images
# IMAGE_STORE_ORIGIN=http://localhost:5173
