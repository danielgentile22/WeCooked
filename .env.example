# Copy to .env for local dev. Production values are Fly secrets (SPEC 9.3).
APP_PASSWORD_HASH=   # argon2id hash of the shared password
SESSION_SECRET=      # cookie signing key; rotating it logs everyone out
DATABASE_PATH=local.db
# R2 (Litestream replication + restore drill). Token: dashboard > R2 > Manage API Tokens,
# Object Read & Write, scoped to the "wecooked" bucket only.
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
